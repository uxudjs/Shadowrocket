#!name=Apple System

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP

# > SafariPrivacy
DOMAIN,safebrowsing.urlsec.qq.com,REJECT
DOMAIN,safebrowsing.googleapis.com,REJECT
DOMAIN,e.crashlytics.com,REJECT

# > AppleIntelligence
DOMAIN-SUFFIX,gateway.icloud.com,PROXY
DOMAIN-SUFFIX,apple-relay.apple.com,PROXY
DOMAIN-SUFFIX,apple-relay.fastly-edge.com,PROXY
DOMAIN-SUFFIX,apple-relay.cloudflare.com,PROXY
DOMAIN-SUFFIX,guzzoni.apple.com,PROXY
DOMAIN-SUFFIX,cp4.cloudflare.com,PROXY
DOMAIN-SUFFIX,gspe1-ssl.ls.apple.com,PROXY
DOMAIN-SUFFIX,smoot.apple.com,PROXY
DOMAIN-SUFFIX,apple-relay.akamaized.net,PROXY
DOMAIN-SUFFIX,apple-relay.mask.apple-dns.net,PROXY

# > AppleDomain
DOMAIN-SUFFIX,akadns.net,DIRECT
DOMAIN-SUFFIX,akamaiedge.net,DIRECT
DOMAIN-SUFFIX,cdn20.com,DIRECT
DOMAIN-SUFFIX,digicert.com,DIRECT
DOMAIN-SUFFIX,edgekey.net,DIRECT
DOMAIN-SUFFIX,edgesuite.net,DIRECT
DOMAIN-SUFFIX,me.com,DIRECT
DOMAIN-SUFFIX,mwcname.com,DIRECT
DOMAIN-SUFFIX,mwcloudcdn.com,DIRECT
DOMAIN-SUFFIX,mzstatic.com,DIRECT
DOMAIN-SUFFIX,omtrdc.net,DIRECT

# > AppleKeyword
DOMAIN-KEYWORD,aaplimg,DIRECT
DOMAIN-KEYWORD,apple,DIRECT
DOMAIN-KEYWORD,icloud,DIRECT
DOMAIN-KEYWORD,itunes,DIRECT
DOMAIN-KEYWORD,smp-device,DIRECT
DOMAIN-KEYWORD,testflight,DIRECT

# > AppleUserAgent
USER-AGENT,AppleTV*,DIRECT
USER-AGENT,FindMyFriends*,DIRECT
USER-AGENT,FindMyiPhone*,DIRECT
USER-AGENT,FMDClient*,DIRECT
USER-AGENT,FMFD*,DIRECT
USER-AGENT,Maps*,DIRECT
USER-AGENT,Music*,DIRECT
USER-AGENT,Wallet*,DIRECT
USER-AGENT,WeatherFoundation*,DIRECT
USER-AGENT,cloudd*,DIRECT
USER-AGENT,fmflocatord*,DIRECT
USER-AGENT,geod*,DIRECT
USER-AGENT,locationd*,DIRECT
USER-AGENT,passd*,DIRECT
AND,((NOT,((USER-AGENT,*com.apple.WebKit*))),(USER-AGENT,*com.apple.*),(NOT,((USER-AGENT,*AssistantServices*)))),DIRECT

# > AppleIP
IP-CIDR,17.0.0.0/8,DIRECT,no-resolve
IP-CIDR,63.92.224.0/19,DIRECT,no-resolve
IP-CIDR,65.199.22.0/23,DIRECT,no-resolve
IP-CIDR,139.178.128.0/18,DIRECT,no-resolve
IP-CIDR,144.178.0.0/19,DIRECT,no-resolve
IP-CIDR,192.35.50.0/24,DIRECT,no-resolve
IP-CIDR,198.183.17.0/24,DIRECT,no-resolve
IP-CIDR,205.180.175.0/24,DIRECT,no-resolve
IP-CIDR6,2403:300::/32,DIRECT,no-resolve
IP-CIDR6,2620:149::/32,DIRECT,no-resolve
IP-CIDR6,2a01:b740::/32,DIRECT,no-resolve
