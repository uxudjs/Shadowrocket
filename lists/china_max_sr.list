align-items: center;
background-color: #0056b3;
background-color: #007aff;
background-color: #f5f5f7;
background: #ffffff;
body {
border-radius: 12px;
border-radius: 6px;
box-shadow: 0 4px 20px rgba(0,0,0,0.08);
clearInterval(interval);
color: #007aff;
color: #1d1d1f;
color: #484848;
color: #86868b;
color: #d93025;
color: white;
const interval = setInterval(() => {
const timerElement = document.getElementById('timer');
display: flex;
display: inline-block;
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
font-size: 12px;
font-size: 16px;
font-size: 24px;
font-weight: 500;
font-weight: bold;
h1 {
height: 100vh;
if (timeLeft <= 0) {
justify-content: center;
let timeLeft = 5;
line-height: 1.6;
margin-bottom: 10px;
margin-top: 20px;
margin-top: 30px;
margin: 0;
max-width: 400px;
p {
padding: 12px 24px;
padding: 40px;
text-align: center;
text-decoration: none;
timeLeft--;
timerElement.textContent = timeLeft;
transition: background 0.2s;
width: 90%;
}
}, 1000);
